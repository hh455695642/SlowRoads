ts(\"t:HillsSceneSettings\",new[]{\"Assets/SlowRoads\"});\n        var config=AssetDatabase.LoadAssetAtPath<HillsSceneSettings>(\"Assets/SlowRoads/Settings/Hills/HillsSceneSettings.asset\");\n        Inspect(config);\n        var materials=new List<object>();\n        foreach(var guid in AssetDatabase.FindAssets(\"t:Material\",new[]{\"Assets/SlowRoads\"}))\n        {\n            var path=AssetDatabase.GUIDToAssetPath(guid);\n            var material=AssetDatabase.LoadAssetAtPath<Material>(path);Inspect(material);\n            if(material.shader==null||!material.shader.isSupported)invalidReferences.Add(path+\":shader missing or unsupported\");\n        }\n        foreach(var m in config.terrainMaterials)\n        {\n            var required=new[]{\"grassMap\",\"rockMap\",\"rockMapBump\",\"gravelMap\",\"sandMap\",\"forestMap\",\"heatherMap\",\"detailNearMap\",\"detailFarMap\",\"grassVariationMap\",\"offroadMap\",\"fadeFine\"};\n            var absent=required.Where(name=>!m.HasProperty(name)||m.GetTexture(name)==null).ToArray();\n            materials.Add(new {path=AssetDatabase.GetAssetPath(m),shader=m.shader.name,instancing=m.enableInstancing,season=m.GetFloat(\"seasonIndex\"),missingTextures=absent});\n        }\n        var shader=Shader.Find(\"SlowRoads/Hills/Terrain\");\n        var flags=BindingFlags.Static|BindingFlags.Public|BindingFlags.NonPublic;\n        var variants=(ulong)typeof(ShaderUtil).GetMethod(\"GetVariantCount\",flags,null,new[]{typeof(Shader),typeof(bool)},null).Invoke(null,new object[]{shader,true});\n        var batcher=(int)typeof(ShaderUtil).GetMethod(\"GetSRPBatcherCompatibilityCode\",flags).Invoke(null,new object[]{shader,0});\n        return new {\n            utc=DateTime.UtcNow.ToString(\"O\"),scene=scene.path,sceneGuid=AssetDatabase.AssetPathToGUID(scene.path),dirty=scene.isDirty,\n            playing=Application.isPlaying,paused=EditorApplication.isPaused,background=Application.runInBackground,compiling=EditorApplication.isCompiling,