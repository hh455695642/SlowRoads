      "lines": [
        {
          "line": "OVL0001",
          "text": "if(overlap > 0.0) {"
        },
        {
          "line": "OVL0002",
          "text": ""
        },
        {
          "line": "OVL0003",
          "text": "    float overlapDist = overlap - vehicleIndex;"
        },
        {
          "line": "OVL0004",
          "text": ""
        },
        {
          "line": "OVL0005",
          "text": "    if(overlapDist > 0.0) {"
        },
        {
          "line": "OVL0006",
          "text": ""
        },
        {
          "line": "OVL0007",
          "text": "      if(overlapDist < sinkDist) {"
        },
        {
          "line": "OVL0008",
          "text": ""
        },
        {
          "line": "OVL0009",
          "text": "          float halfSinkDist = sinkDist * 0.75;"
        },
        {
          "line": "OVL0010",
          "text": ""
        },
        {
          "line": "OVL0011",
          "text": "          if(overlapDist < halfSinkDist) {"
        },
        {
          "line": "OVL0012",
          "text": "            transformed.y -= 20.0;"
        },
        {
          "line": "OVL0013",
          "text": "          } else {"
        },
        {
          "line": "OVL0014",
          "text": "            transformed.y -= 20.0 * (sinkDist - overlapDist) / (sinkDist - halfSinkDist);"
        },
        {
          "line": "OVL0015",
          "text": "          }"
        },
        {
          "line": "OVL0016",
          "text": "      }"
        },
        {
          "line": "OVL0017",
          "text": ""
        },
        {
          "line": "OVL0018",
          "text": "    } else {"
        },
        {
          "line": "OVL0019",
          "text": ""
        },
        {
          "line": "OVL0020",
          "text": "      float fSinkDist = -sinkDist/2.0;"
        },
        {
          "line": "OVL0021",
          "text": ""
        },
        {
          "line": "OVL0022",
          "text": "      if(overlapDist > fSinkDist) {"
        },
        {
          "line": "OVL0023",
          "text": ""
        },
        {
          "line": "OVL0024",
          "text": "        float halfSinkDist = fSinkDist / 2.0;"
        },
        {
          "line": "OVL0025",
          "text": ""
        },
        {
          "line": "OVL0026",
          "text": "        if(overlapDist > halfSinkDist) {"
        },
        {
          "line": "OVL0027",
          "text": "          transformed.y -= 20.0;"
        },
        {
          "line": "OVL0028",
          "text": "        } else {"
        },
        {
          "line": "OVL0029",
          "text": "          transformed.y -= 20.0 * (fSinkDist - overlapDist) / halfSinkDist;"
        },
        {
          "line": "OVL0030",
          "text": "        }"
        },
        {
          "line": "OVL0031",
          "text": ""
        },
        {
          "line": "OVL0032",
          "text": "      }"
        },
        {
          "line": "OVL0033",
          "text": ""
        },
        {
          "line": "OVL0034",
          "text": "    }"
        },
        {
          "line": "OVL0035",
          "text": ""
        },
        {
          "line": "OVL0036",
          "text": "    // Recalc mvPosition"
        },
        {
          "line": "OVL0037",
          "text": "    mvPosition = modelViewMatrix * vec4( transformed, 1.0 );"
        },
        {
          "line": "OVL0038",
          "text": "}"
        },
